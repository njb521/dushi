{
  "name": "dushi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "四人联机「独食」（钦州独食 / 广西独食）",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "npm run test:rules && npm run test:server",
    "test:rules": "node --test \"packages/rules/test/*.test.ts\"",
    "test:server": "node --test \"packages/server/test/*.test.ts\"",
    "test:watch": "node --test --watch \"packages/rules/test/*.test.ts\"",
    "play": "node packages/rules/cli/play.ts",
    "soak": "node packages/rules/cli/sim.ts",
    "build": "npm run build -w @dushi/web",
    "start": "node packages/server/src/index.ts",
    "dev:server": "npm run dev -w @dushi/server",
    "dev:web": "npm run dev -w @dushi/web",
    "e2e": "node packages/server/scripts/e2e.ts",
    "reset-password": "node packages/server/scripts/reset-password.ts"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "msgpackr-extract@3.0.7": true
  }
}
